{
  "name": "MyPersonalWeb",
  "version": "1.0.0",
  "description": "Álvaro Rodríguez Molina's portfolio: React, TypeScript and SCSS built with Vite",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:game": "vite --open /game.html",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build/build.mjs && node bug-hunter/scripts/check-public.mjs",
    "test:game:layout": "node --test bug-hunter/tests/integration.test.mjs bug-hunter/tests/asset-layout.test.mjs",
    "test:game": "node bug-hunter/scripts/check-regressions.mjs && node --test bug-hunter/tests/siege.test.mjs bug-hunter/tests/siege-legacy.test.mjs bug-hunter/tests/skins.test.mjs",
    "test:game:shop": "node bug-hunter/scripts/check-shop.mjs",
    "test:game:siege": "node --test bug-hunter/tests/siege.test.mjs bug-hunter/tests/siege-legacy.test.mjs",
    "ai:maintenance": "node scripts/radar/daily-ai-maintenance.mjs",
    "ai:radar": "node scripts/radar/daily-ai-maintenance.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Alvaro Rodriguez Molina",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "peerjs": "^1.5.5",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
